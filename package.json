{
  "name": "poker-trainer",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "德州扑克单人练习网页：6 人桌对局 + 三档 AI 对手 + 逐决策点 EV 复盘 + 分级胜率计算（查表 / 精确枚举 / 蒙特卡洛）",
  "keywords": [
    "poker",
    "texas-holdem",
    "texas-holdem-poker",
    "holdem",
    "poker-trainer",
    "poker-ai",
    "equity",
    "monte-carlo",
    "react",
    "typescript",
    "vite"
  ],
  "homepage": "https://xv-xiong.github.io/poker-trainer/",
  "repository": {
    "type": "git",
    "url": "https://github.com/xv-xiong/poker-trainer.git"
  },
  "bugs": {
    "url": "https://github.com/xv-xiong/poker-trainer/issues"
  },
  "license": "MIT",
  "author": "xv-xiong",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:table": "node scripts/gen-preflop-table.mjs",
    "gen:anchors": "node scripts/gen-exact-anchors.mjs",
    "verify": "node scripts/verify-all.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fast-check": "4.10.2",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
